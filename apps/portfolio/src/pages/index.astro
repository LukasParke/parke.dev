---
const links = [
  { title: "Blog", url: "https://blog.parke.dev" },
  { title: "GitHub", url: "https://github.com/lukehagar", external: true },
  {
    title: "Bluesky",
    url: "https://bsky.app/profile/lukehagar.com",
    external: true,
  },
  {
    title: "LinkedIn",
    url: "https://linkedin.com/in/lukehagar",
    external: true,
  },
  { title: "Email", url: "mailto:luke@parke.dev" },
];

const projects = [
  {
    name: "home-ops",
    description:
      "A GitOps-driven Kubernetes homelab running on Talos Linux — Flux, Cilium, and a fleet of self-hosted services, all declared in one repository.",
    url: "https://github.com/LukasParke/home-ops",
    tags: ["Kubernetes", "Talos", "Flux", "GitOps"],
  },
  {
    name: "parke.dev",
    description:
      "This site and my blog, built as a Bun workspace monorepo with Astro and deployed to the homelab through CI-published OCI images.",
    url: "https://github.com/LukasParke/parke.dev",
    tags: ["Astro", "Bun", "CI/CD"],
  },
  {
    name: "The blog",
    description:
      "Writing on homelabs, SvelteKit, self-hosting, and whatever else I have been building or breaking lately.",
    url: "https://blog.parke.dev",
    tags: ["Astro", "MDX", "Svelte"],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Luke Parke — Software Engineer</title>
    <meta
      name="description"
      content="Luke Parke is a software engineer in Austin, Texas building developer tools, APIs, and a very over-engineered homelab."
    />
    <meta property="og:title" content="Luke Parke — Software Engineer" />
    <meta
      property="og:description"
      content="Software engineer in Austin, Texas building developer tools, APIs, and a very over-engineered homelab."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://parke.dev" />
  </head>
  <body>
    <main>
      <header class="hero">
        <img
          class="portrait"
          src="/portrait.jpg"
          alt="Portrait of Luke Parke"
          width="112"
          height="112"
        />
        <h1>Luke Parke</h1>
        <p class="tagline">Software Engineer · Austin, Texas</p>
        <p class="intro">
          I build developer tools, APIs, and the occasional
          over-engineered homelab. This site, the blog, and the cluster
          serving them are all declared in code — from the Talos nodes up
          to this page.
        </p>
        <nav class="links" aria-label="Profiles and contact">
          {
            links.map((link) => (
              <a
                href={link.url}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
              >
                {link.title}
              </a>
            ))
          }
        </nav>
      </header>

      <section aria-labelledby="work-heading">
        <h2 id="work-heading">Selected work</h2>
        <ul class="projects">
          {
            projects.map((project) => (
              <li>
                <a class="project" href={project.url}>
                  <h3>{project.name}</h3>
                  <p>{project.description}</p>
                  <ul class="tags" aria-label="Technologies">
                    {project.tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <footer>
        <p>
          © {new Date().getFullYear()} Luke Parke ·
          <a href="https://blog.parke.dev">blog.parke.dev</a>
        </p>
      </footer>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: dark;
    --bg: oklch(0% 0 none);
    --surface: oklch(21% 0.006 285.885);
    --border: oklch(30% 0.008 285.885);
    --text: oklch(92% 0.004 286.32);
    --muted: oklch(70% 0.01 286.32);
    --accent: oklch(76% 0.12 210);
  }

  * {
    margin: 0;
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
  }

  body {
    font-family:
      ui-sans-serif,
      system-ui,
      -apple-system,
      "Segoe UI",
      Roboto,
      sans-serif;
    color: var(--text);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  main {
    max-width: 44rem;
    margin: 0 auto;
    padding: 4rem 1.5rem 2rem;
  }

  .hero {
    text-align: center;
    margin-bottom: 4rem;
  }

  .portrait {
    border-radius: 50%;
    border: 2px solid var(--border);
    object-fit: cover;
    margin-bottom: 1.25rem;
  }

  h1 {
    font-size: 2.25rem;
    letter-spacing: -0.02em;
  }

  .tagline {
    color: var(--muted);
    margin-top: 0.25rem;
  }

  .intro {
    max-width: 36rem;
    margin: 1.25rem auto 0;
    color: var(--muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .links a {
    color: var(--text);
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    padding: 0.35rem 0.85rem;
    transition:
      border-color 120ms ease,
      color 120ms ease;
  }

  .links a:hover,
  .links a:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }

  h2 {
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .projects {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .project {
    display: block;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    padding: 1.25rem 1.5rem;
    color: inherit;
    text-decoration: none;
    transition: border-color 120ms ease;
  }

  .project:hover,
  .project:focus-visible {
    border-color: var(--accent);
  }

  .project h3 {
    font-size: 1.05rem;
  }

  .project p {
    color: var(--muted);
    margin-top: 0.35rem;
    font-size: 0.95rem;
  }

  .tags {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }

  .tags li {
    font-size: 0.75rem;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
  }

  footer {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
  }

  footer a {
    color: inherit;
  }
</style>
