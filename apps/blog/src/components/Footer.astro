---
import { socialLinks } from "@src/data/social-links";

const currentYear = new Date().getFullYear();
---

<footer class="section-padding border-surface-800 border-t py-5">
  <div class="container mx-auto flex flex-col items-center gap-5">
    <div class="flex space-x-4">
      {
        socialLinks.map((link) => (
          <a
            class="btn btn-sm hover:preset-tonal-primary font-mono-brand text-xs uppercase tracking-widest"
            href={link.url}
            target={link.target}
            rel="noreferrer"
            title={link.title}
          >
            {link.title}
          </a>
        ))
      }
    </div>
    <p class="font-mono-brand text-xs opacity-50">
      © Copyright {currentYear} Luke Parke · served from a closet in Austin, TX
    </p>
  </div>
</footer>
